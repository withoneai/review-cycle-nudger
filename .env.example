# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection keys from `one --agent connection list` (the `key` field)
ONE_CONNECTION_NOTION=
ONE_CONNECTION_SLACK=

# The Notion data source that holds one row per review. Open the database,
# copy its data source id (Notion: database menu, "Copy data source ID").
NOTION_REVIEWS_DATA_SOURCE_ID=

# Where the digest goes: the people-ops channel, not the managers. Channel id, e.g. C0123456789
SLACK_CHANNEL=

# Optional: column names on the reviews data source, if yours differ
# PROP_EMPLOYEE=Employee
# PROP_MANAGER=Manager
# PROP_STATUS=Status
# PROP_DUE=Due
# PROP_GOALS_DOC=Goals doc

# Optional: override the Claude model
# CLAUDE_MODEL=claude-opus-5-5
